cdu=cd /d %USERPROFILE%
cdh=cd /d %HOME%\
cds=cd /d %PRGS%
cdb=cd /d "%HOME%\bin"
cdg=cd /d %PROG%\git
cdgg=cd /d %PROG%\git\git
cdd=cd /d %PROG%
cdl=cd /d %USERPROFILE%\Downloads
cdi=cd /d "%PRGS%\senv"

pz=%pz%\peazip.exe $*
pzx=%sz% x -aos -o$2 -pdefault -sccUTF-8 ^"$1^"
pzc=%sz% a -tzip -mm=Deflate -mmt=on -mx5 -w "$2" "$1"
senv=call "%USERPROFILE%\senv.bat"

vscode="%PRGS%\vscodes\current\bin\code.cmd" $*

gl=git lg -10
gla=git lg --all
glab=git lg --all --branches
gcie=git commit --allow-empty -m "Initial empty commit"
gc=git commit $*
gcam=git commit --amend --no-edit
gca=git commit --amend
gcamm=git commit --amend -m "$*"
gcm=git commit -m "$*"
gcma=git commit --amend -m "$*"
ga=git add .
gs=git st
gp=git push
gpft=git push --follow-tags $*
grc=cmd /V /C "set "GIT_EDITOR=true" && git rebase --continue"
gdni=git diff --no-index --color-words=. $*
gd=git diff --color-words=. $*
gdc=git diff --cached --color-words=. $*

aliasr=DOSKEY /MACROFILE="%HOME%\bin\senv.doskey"&& DOSKEY /MACROFILE="%HOME%\bin\senv.custom.doskey"&& DOSKEY /MACROFILE="%HOME%\bin\senv.local.doskey"
aliase="%PRGS%\vscodes\current\bin\code.cmd" "%HOME%\bin\senv.local.doskey"
senve="%PRGS%\vscodes\current\bin\code.cmd" "%HOME%\bin\senv.local.bat"

clear=cls
e.=explorer .
ls=ls --show-control-chars -F --color $*
ll=ls -alrth  --show-control-chars -F --color $*
vi=vim $*

dlc=dwlchrome.bat
dlg=dwlgit.bat
dlf=dwlfirefox.bat
dlgh=dwlgh.bat
dllg=dwllg.bat
dlgum=dwlgum.bat
gum="%PRGS%\gums\gum.exe" $*