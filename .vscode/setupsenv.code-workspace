{
	"folders": [
		{
			"path": "..\\custom"
		},
		{
			"path": ".."
		}
	],
	"settings": {
		"workspaceHalo.rootSynonyms": ["senv"],
		"workbench.colorCustomizations": {
			"activityBar.activeBackground": "#0ed941",
			"activityBar.activeBorder": "#8c69f5",
			"activityBar.background": "#0ed941",
			"activityBar.foreground": "#15202b",
			"activityBar.inactiveForeground": "#15202b99",
			"activityBarBadge.background": "#8c69f5",
			"activityBarBadge.foreground": "#15202b",
			"statusBar.background": "#0ba933",
			"statusBar.foreground": "#e7e7e7",
			"statusBarItem.hoverBackground": "#0ed941",
			"titleBar.activeBackground": "#0ba933",
			"titleBar.activeForeground": "#e7e7e7",
			"titleBar.inactiveBackground": "#0ba93399",
			"titleBar.inactiveForeground": "#e7e7e799",
			"sash.hoverBorder": "#0ed941",
			"statusBarItem.remoteBackground": "#5f2ef1",
			"statusBarItem.remoteForeground": "#e7e7e7",
			"commandCenter.border": "#e7e7e799",
			"tab.activeBorder": "#0ed941",
			"activityBarTop.activeBackground": "#0ed941",
			"activityBarTop.background": "#0ed941",
			"activityBarTop.foreground": "#15202b",
			"activityBarTop.inactiveForeground": "#15202b99",
			"commandCenter.foreground": "#e7e7e7",
			"statusBar.debuggingBackground": "#0ba933",
			"statusBar.debuggingForeground": "#e7e7e7"
		},
		"peacock.color": "#0ba933",
		"replacerules.rules": {
			"Update _message with nx0": {
				"find": "%_(.*?)% \"([^\\[])",
				"replace": "%_$1% \"[%~nx0] $2",
				"flags": "gmi"
			},
		},
    "replacerules.rulesets": {
			"Update xxx messages": {
				"rules": [
					"Update _message with nx0",
				]
			},
		},
		"github.copilot.chat.otel.dbSpanExporter.enabled": true,
	}
}
